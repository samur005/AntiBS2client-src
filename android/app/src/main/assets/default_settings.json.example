            "pingTimeoutSec": 5,
            "pingUrl": "https://www.gstatic.com/generate_204",
            "pingDisplay": "time",
            "autoPingServers": false,
            "hideEmptyManual": true,
            "logging": false,
            "logLevel": "warning",
            "language": "ru",
            "perAppMode": "bypass",
