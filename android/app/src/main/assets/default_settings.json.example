{
    "_comment": "First-run defaults baked in as default_settings.json. Applied only when the app has no seeded prefs yet (fresh install). Subscriptions, servers, secrets, subscription-URL hashes, and subscription-tied routing / grouping ids are never stored here.",
    "schemaVersion": 1,
    "appVersion": "2.2.0",
    "exportedAt": "",
    "prefs": {
        "theme": "auto",
        "bypassLan": true,
        "fragmentation": false,
        "mux": false,
        "ipType": "auto",
        "allowLan": false,
        "autostart": false,
