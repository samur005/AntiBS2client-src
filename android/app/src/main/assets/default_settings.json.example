{
    "_comment": "Copy this file to default_settings.json in the same folder to bake these prefs in as first-run defaults. Applied only when the app has no seeded prefs yet (fresh install). Subscriptions, servers and secrets are never read from this file.",
    "schemaVersion": 1,
    "appVersion": "2.0.34",
    "exportedAt": "",
    "prefs": {
        "theme": "auto",
        "bypassLan": true,
        "fragmentation": false,
        "mux": false,
        "ipType": "auto",
        "allowLan": false,
        "autostart": false,
        "xrayTun": false,
        "subsExpanded": true,
        "compactServers": false,
        "sortByPing": false,
        "hostGrid": false,
        "pingTimeoutMs": 3000,
        "qwdttDns": "yandex",
        "qwdttObfs": "audio",
        "qwdttTurnTcp": false,
        "autoUpdateCheck": true,
        "subAutoUpdate": true,
        "subUpdateHours": 6,
        "subUpdateWifiOnly": false,
        "adv": {}
    },
    "styles": {
        "style": "classic",
        "sort": "added",
        "subNewestFirst": true,
        "options": {},
        "filter": {}
    },
    "schedule": null
}
